ALIGNYARD_AUTH_MODE=google
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
ALIGNYARD_ALLOWED_EMAILS=you@example.com
# Set to 1 instead of ALIGNYARD_ALLOWED_EMAILS only when every verified Google account is allowed.
# ALIGNYARD_AUTH_ALLOW_ANY_GOOGLE=1
ALIGNYARD_DOMAIN=alignyard.example.com
# Optional when an upstream proxy/load balancer supplies x-forwarded-* headers.
ALIGNYARD_TRUST_PROXY=loopback
