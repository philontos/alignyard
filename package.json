{
  "name": "alignyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloud collaboration platform with owner-local coding agent runners",
  "scripts": {
    "dev": "tsx watch server/platform/main.ts",
    "start": "tsx server/platform/main.ts",
    "runner": "tsx server/runner/main.ts",
    "ay": "tsx server/ay.ts",
    "build:runner:macos": "./scripts/build-runner-macos.sh",
    "test": "node --import tsx --test \"server/**/*.test.ts\" \"web/**/*.test.mjs\"",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
